<Window x:Class="GameLab3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameLab3"
        mc:Ignorable="d"
        Title="GameLab3 — Собери шарики"
        Height="560" Width="900"
        MinHeight="460" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F0F0F0"
                BorderBrush="#CCCCCC" BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GameLab3" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Собери как можно больше шариков за 30 секунд"
                               FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="BtnStart" Content="Начать игру"
                        Width="130" Height="32"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="BtnStart_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F9F9F9"
                    BorderBrush="#CCCCCC" BorderThickness="1"
                    Margin="0,0,12,0">
                <Grid>
                    <TextBlock x:Name="TxtHint"
                               Text="Нажмите «Начать игру»"
                               FontSize="16" Foreground="Gray"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <Canvas x:Name="GameCanvas" Background="Transparent"
                            ClipToBounds="True" MouseDown="GameCanvas_MouseDown"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White"
                    BorderBrush="#CCCCCC" BorderThickness="1">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Счёт"
                               FontSize="12" Foreground="Gray"/>
                    <TextBlock Grid.Row="1" x:Name="TxtScore"
                               Text="0" FontSize="30" FontWeight="Bold"
                               Margin="0,0,0,14"/>

                    <TextBlock Grid.Row="2" Text="Время"
                               FontSize="12" Foreground="Gray"/>
                    <TextBlock Grid.Row="3" x:Name="TxtTime"
                               Text="0,0 с" FontSize="22" FontWeight="Bold"/>
                    <ProgressBar Grid.Row="4" x:Name="TimeBar"
                                 Height="6" Minimum="0" Maximum="30"
                                 Margin="0,6,0,16"/>

                    <Border Grid.Row="5" Height="1" Background="#CCCCCC"
                            Margin="0,0,0,14"/>

                    <TextBlock Grid.Row="6" Text="Лог событий"
                               FontSize="12" Foreground="Gray"
                               Margin="0,0,0,6"/>
                    <ListBox Grid.Row="7" x:Name="LogList"
                             Background="#F9F9F9" BorderBrush="#CCCCCC"
                             FontSize="11"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
